generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id        String   @id @default(uuid())
  googleId  String?  @unique
  name      String
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns EmailCampaign[]
}

model Sender {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String
  etherealUser     String
  etherealPassword String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  emailJobs EmailJob[]
}

model EmailCampaign {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject            String
  body               String   @db.Text
  startTime          DateTime
  delayBetweenEmails Int      // Delay between email sends in milliseconds
  hourlyLimit        Int      // Max emails permitted per hour for this sender
  totalRecipients    Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  emailJobs EmailJob[]
}

model EmailJob {
  id                 String     @id @default(uuid())
  campaignId         String
  campaign           EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId           String
  sender             Sender     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  recipient          String
  subject            String
  body               String     @db.Text
  scheduledAt        DateTime
  sentAt             DateTime?
  status             JobStatus  @default(SCHEDULED)
  attempts           Int        @default(0)
  lastError          String?    @db.Text
  bullJobId          String?
  idempotencyKey     String     @unique
  etherealPreviewUrl String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([recipient])
  @@index([campaignId])
  @@index([senderId])
  @@index([idempotencyKey])
}
